# Drizzle
DATABASE_URL=local.db

# Better Auth
# Use the public application origin. Do not add a final slash.
ORIGIN=http://localhost:5173

# For production, use at least 32 random characters.
# Generate a value with: npx auth secret
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Keep this false until the privacy notice and submission terms are final.
CONTRIBUTIONS_ENABLED=false
